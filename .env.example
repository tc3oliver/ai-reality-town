# ---------------------------------------------------------------------------
# AI Reality Town environment example.
#
# Copy to `.env` (or `.env.local`) and fill in REAL values only locally.
# NEVER commit real values. `.env`, `.env.local`, and `.env.*.local` are gitignored.
#
# The deterministic Fake Simulation Provider and offline checks need none of the LLM
# variables below. Real credentials belong in the target Convex deployment environment
# (`npx convex env set ...`), not this file or a browser-visible VITE_* variable.
# ---------------------------------------------------------------------------

# --- Convex (only needed to RUN the live simulation, not to build/test) ---
# CONVEX_DEPLOYMENT=your-deployment-name
# VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- OpenAI-compatible LLM provider (server-side Convex environment only) ---
# Base may end in /v1, /v1/chat/completions, or /v1/embeddings; endpoints are normalized.
# LLM_API_URL=https://your-provider.example.com/v1
# LLM_MODEL=your-chat-model
# LLM_EMBEDDING_MODEL=your-embedding-model
# LLM_EMBEDDING_DIMENSION=1024
# LLM_API_KEY=set-in-convex-environment-not-here
# Explicit endpoint overrides are optional.
# LLM_CHAT_API_URL=https://your-provider.example.com/v1/chat/completions
# LLM_EMBEDDING_API_URL=https://your-provider.example.com/v1/embeddings
# Use only for an endpoint that explicitly permits requests without Authorization.
# LLM_ALLOW_UNAUTHENTICATED=false
# LLM_TIMEOUT_MS=30000
# LLM_MAX_ATTEMPTS=3

# --- Simulation operations console (server-side Convex environment ONLY) ---
# Authorized operator registry for the FR-K001 admin console. Set it with
# `npx convex env set SIMULATION_OPS_OPERATORS '<json>'` — NEVER as a VITE_* variable
# and never with real values in this file. Unset means "no operator is authorized".
# Entries: operatorId, role (viewer|operator|admin), subjects (verified auth subjects),
# optional token (bootstrap ops token), optional worldIds allowlist, optional disabled.
# See docs/simulation-operations-console.md.
# SIMULATION_OPS_OPERATORS=[{"operatorId":"ops-admin","role":"admin","subjects":["clerk|user_123"]}]

# --- Observability (NOT USED in Phase 0) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
