      "internalMutation",
      "ctx.db.insert",
      "ctx.db.patch",
      "ctx.db.replace",
      "ctx.db.delete",
      "canonEvents",
      "commitProposedEvent",
      "validateAndCommitProposedEvent",
      "reduceWorldEvent",
      "seedWorldCharacters",
      "importWorld"
    ]
  },
  "providerBoundary": {
    "contract": "convex/simulation/provider.ts",
    "contractVersion": 1,
    "adapterRoots": [
      "convex/simulation/providers"
    ],
    "providerPackagePatterns": [
      "^openai$",
      "^@anthropic-ai/",
      "^@google/generative-ai$"
    ]
  },
  "analyticsWriteBoundary": {
    "roots": [
      "convex/analytics"
    ],
    "clientRoots": [
      "src/components/analytics"
    ],
    "maxTelemetryMutations": 1,
    "requiredSymbols": [
      "sanitizeAnalyticsPayload",
      "analyticsDedupeKey"
    ],
    "forbiddenSymbols": [
      "canonEvents",
      "commitProposedEvent",
      "validateAndCommitProposedEvent",
      "reduceWorldEvent",
      "replayWorldEvents",
      "seedWorldCharacters",
      "importWorld",
      "commitReadModelVersion",
      "requireOperator",
      "internalAction"
    ],
    "forbiddenPayloadKeys": [
      "viewerId",
      "ip",
      "ipAddress",
      "userAgent",
      "accountId",
      "email",
      "prompt",
      "apiKey",
      "token",
      "secret",
      "memory",
      "knowledge",
      "dialogue",
      "publicSummary",
      "headline",
      "summary",
      "privateGoal",
      "fear"
